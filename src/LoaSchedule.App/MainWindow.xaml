<Window x:Class="LoaSchedule.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:LoaSchedule.App.Behaviors"
        Title="Loa Schedule"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Malgun Gothic"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="LOA SCHEDULE" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="관리자용 레이드 · 캐릭터 · 주간 편성 관리" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="14,8"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8">
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="LOCAL MODE" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="대시보드">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,22,0,0">
                        <UniformGrid Columns="3">
                            <Border Margin="0,0,12,0" Padding="22" Background="{StaticResource PanelBrush}" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="활성 참여자" />
                                    <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="Bold" Text="{Binding ActivePeopleCount}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0" Padding="22" Background="{StaticResource PanelBrush}" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="등록 캐릭터" />
                                    <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="Bold" Text="{Binding ActiveCharacterCount}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="12,0,0,0" Padding="22" Background="{StaticResource PanelBrush}" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="활성 레이드 기준" />
                                    <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="Bold" Text="{Binding ActiveRaidCount}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Margin="0,24,0,0" Padding="24" Background="{StaticResource PanelBrush}" CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="자동 편성 준비 상태" />
                                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                    참여자, 캐릭터와 주간 레이드를 등록하면 시너지 호환성을 반영한 공격대 자동 편성을 실행할 수 있습니다.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="참여자 · 캐릭터">
                <Grid Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewPersonName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding AddPersonCommand}" Content="{Binding PersonSubmitText}" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Background="#566077" Command="{Binding CancelPersonEditCommand}" Content="수정 취소" />
                            <TextBlock Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="수정할 때는 아래 목록의 수정 버튼을 누르세요." />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Lost Ark API 키" />
                            <PasswordBox Grid.Column="1"
                                         Margin="10,0,0,0"
                                         behaviors:PasswordBoxBinding.BindPassword="True"
                                         behaviors:PasswordBoxBinding.BoundPassword="{Binding LostArkApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SaveApiTokenCommand}" Content="API 키 저장" />
                            <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding LostArkApiTokenStatus}" />
                            <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#D6A35A" Text="로컬 JSON에 저장됨" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="소유자" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" Text="캐릭터명" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource MutedTextBrush}" Text="API 조회 결과" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource MutedTextBrush}" Text="역할" />
                            <TextBlock Grid.Column="5" Foreground="{StaticResource MutedTextBrush}" Text="전투력(직접 입력)" />
                            <ComboBox Grid.Row="1"
                                      Margin="0,5,0,0"
                                      ItemsSource="{Binding People}"
                                      ItemTemplate="{StaticResource PersonComboItemTemplate}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding NewCharacterOwnerId}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,5,0,0" Text="{Binding NewCharacterName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="8,5,0,0" Command="{Binding LookupCharacterCommand}" Content="API 조회" />
                            <Border Grid.Row="1" Grid.Column="3" Margin="8,5,8,0" Padding="10,7" Background="#202737" CornerRadius="5">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding CharacterLookupSummary}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,5,0,0" ItemsSource="{Binding CharacterRoles}" SelectedItem="{Binding NewCharacterRole}" />
                            <TextBox Grid.Row="1" Grid.Column="5" Margin="8,5,0,0" Text="{Binding NewCharacterCombatPower, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Row="1" Grid.Column="6" Margin="10,5,0,0" Command="{Binding AddCharacterCommand}" Content="{Binding CharacterSubmitText}" />
                            <Button Grid.Row="1" Grid.Column="7" Margin="8,5,0,0" Background="#566077" Command="{Binding CancelCharacterEditCommand}" Content="취소" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding People}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="참여자" Binding="{Binding Name}" />
                                <DataGridCheckBoxColumn Width="70" Header="활성" Binding="{Binding IsActive}" />
                                <DataGridTemplateColumn Width="215" Header="관리">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Padding="8,4" Command="{Binding DataContext.BeginEditPersonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="수정" />
                                                <Button Margin="4,0,0,0" Padding="8,4" Background="#566077" Command="{Binding DataContext.TogglePersonActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="활성 전환" />
                                                <Button Margin="4,0,0,0" Padding="8,4" Background="#B74755" Command="{Binding DataContext.DeletePersonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="삭제" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 캐릭터가 많을 때 한 참여자만 공라서 볼 수 있게 합니다. -->
                            <Border Margin="0,0,0,8" Padding="10,8"
                                    Background="{StaticResource PanelBrush}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="참여자별 보기" />
                                    <ComboBox Grid.Column="1" Margin="10,0,0,0"
                                              ItemsSource="{Binding CharacterOwnerFilters}"
                                              ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding CharacterOwnerFilterId}" />
                                    <TextBlock Grid.Column="2" Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding CharacterFilterSummary}" />
                                </Grid>
                            </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding CharactersView}">
                            <DataGrid.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource OwnerGroupHeaderTemplate}" />
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="캐릭터" Binding="{Binding CharacterName}" />
                                <DataGridTextColumn Width="130" Header="클래스" Binding="{Binding ClassName}" />
                                <DataGridTextColumn Width="90" Header="역할" Binding="{Binding RoleName}" />
                                <DataGridTextColumn Width="100" Header="아이템 레벨" Binding="{Binding ItemLevel, StringFormat=N2}" />
                                <DataGridTextColumn Width="100" Header="전투력" Binding="{Binding CombatPower, StringFormat=N0}" />
                                <DataGridCheckBoxColumn Width="60" Header="활성" Binding="{Binding IsActive}" />
                                <DataGridTemplateColumn Width="205" Header="관리">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Padding="8,4" Command="{Binding DataContext.BeginEditCharacterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="수정" />
                                                <Button Margin="4,0,0,0" Padding="8,4" Background="#566077" Command="{Binding DataContext.ToggleCharacterActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="활성 전환" />
                                                <Button Margin="4,0,0,0" Padding="8,4" Background="#B74755" Command="{Binding DataContext.DeleteCharacterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="삭제" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="가능 시간">
                <Grid Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="Bold" Text="참여자별 가능 시간" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="시간이 많이 겹치는 참여자를 같은 공격대로 우선 편성합니다. 시간이 없거나 겹치지 않아도 편성은 가능합니다." />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="참여자" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="요일" />
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="시작 시간" />
                            <TextBlock Grid.Column="3" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="종료 시간" />

                            <ComboBox Grid.Row="1"
                                      Margin="0,5,0,0"
                                      ItemsSource="{Binding People}"
                                      ItemTemplate="{StaticResource PersonComboItemTemplate}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding NewAvailabilityPersonId}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      Margin="8,5,0,0"
                                      ItemsSource="{Binding WeekDays}"
                                      ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                      SelectedItem="{Binding NewAvailabilityDay}" />
                            <ComboBox Grid.Row="1" Grid.Column="2"
                                      Margin="8,5,0,0"
                                      ItemsSource="{Binding TimeOptions}"
                                      ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                      SelectedItem="{Binding NewAvailabilityStart}" />
                            <ComboBox Grid.Row="1" Grid.Column="3"
                                      Margin="8,5,0,0"
                                      ItemsSource="{Binding TimeOptions}"
                                      ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                      SelectedItem="{Binding NewAvailabilityEnd}" />
                            <Button Grid.Row="1" Grid.Column="4"
                                    Margin="10,5,0,0"
                                    Command="{Binding AddAvailabilityCommand}"
                                    Content="가능 시간 추가" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" Margin="0,16,0,0" ItemsSource="{Binding AvailabilityWindows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="참여자" Binding="{Binding PersonName}" />
                            <DataGridTextColumn Width="160" Header="요일" Binding="{Binding DayName}" />
                            <DataGridTextColumn Width="180" Header="시작" Binding="{Binding StartTime}" />
                            <DataGridTextColumn Width="180" Header="종료" Binding="{Binding EndTime}" />
                            <DataGridTemplateColumn Width="100" Header="관리">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,4"
                                                Background="#B74755"
                                                Command="{Binding DataContext.RemoveAvailabilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="삭제" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="레이드 기준">
                <Grid Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="그룹 키" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" Text="분류" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" Text="콘텐츠" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource MutedTextBrush}" Text="난이도" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource MutedTextBrush}" Text="입장 레벨" />
                            <TextBlock Grid.Column="5" Foreground="{StaticResource MutedTextBrush}" Text="인원" />
                            <TextBlock Grid.Column="6" Foreground="{StaticResource MutedTextBrush}" Text="파티 크기" />
                            <TextBlock Grid.Column="7" Foreground="{StaticResource MutedTextBrush}" Text="관문" />
                            <TextBlock Grid.Column="8" Foreground="{StaticResource MutedTextBrush}" Text="우선순위" />
                            <TextBox Grid.Row="1" Margin="0,5,8,0" Text="{Binding NewRaidGroupKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,8,0" Text="{Binding NewRaidCategory, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,5,8,0" Text="{Binding NewRaidName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,5,8,0" Text="{Binding NewRaidDifficulty, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Margin="0,5,8,0" Text="{Binding NewRaidMinimumItemLevel, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Row="1" Grid.Column="5" Margin="0,5,8,0" Text="{Binding NewRaidPlayerCount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="6" Margin="0,5,8,0" Text="{Binding NewRaidPartySize, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="7" Margin="0,5,8,0" Text="{Binding NewRaidGateCount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="1" Grid.Column="8" Margin="0,5,8,0" Text="{Binding NewRaidPriority, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Row="1" Grid.Column="9" Margin="2,5,0,0" Command="{Binding SaveRaidCommand}" Content="{Binding RaidSubmitText}" />
                            <Button Grid.Row="1" Grid.Column="10" Margin="8,5,0,0" Background="#566077" Command="{Binding CancelRaidEditCommand}" Content="취소" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Raids}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="150" Header="분류" Binding="{Binding Category}" />
                            <DataGridTextColumn Width="*" Header="콘텐츠" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="120" Header="난이도" Binding="{Binding Difficulty}" />
                            <DataGridTextColumn Width="120" Header="입장 레벨" Binding="{Binding MinimumItemLevel, StringFormat=N0}" />
                            <DataGridTextColumn Width="90" Header="인원" Binding="{Binding PlayerCount}" />
                            <DataGridTextColumn Width="90" Header="관문" Binding="{Binding GateCount}" />
                            <DataGridTextColumn Width="90" Header="우선순위" Binding="{Binding Priority}" />
                            <DataGridCheckBoxColumn Width="60" Header="활성" Binding="{Binding IsActive}" />
                            <DataGridTemplateColumn Width="205" Header="관리">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Padding="8,4" Command="{Binding DataContext.BeginEditRaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="수정" />
                                            <Button Margin="4,0,0,0" Padding="8,4" Background="#566077" Command="{Binding DataContext.ToggleRaidActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="활성 전환" />
                                            <Button Margin="4,0,0,0" Padding="8,4" Background="#B74755" Command="{Binding DataContext.DeleteRaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="삭제" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="시너지 규칙">
                <ScrollViewer Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="직업·세팅별 제공 시너지" />
                        <TextBlock Margin="0,6,0,10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="한 캐릭터가 같은 파티의 다른 인원에게 주는 효과를 등록합니다. 자동 편성은 여기 등록된 수치의 합이 가장 커지도록 파티를 나눕니다." />

                        <Border Margin="0,0,0,12" Padding="14"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="입력 항목 설명" />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 제공 직업 — 시너지를 주는 쪽의 직업명입니다. 캐릭터에 입력한 직업명과 정확히 같아야 인식됩니다. (예: 바드)" />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 세팅(선택) — 특정 각인·세팅에서만 나오는 시너지일 때 입력합니다. 비워두면 그 직업의 모든 세팅에 적용됩니다. (예: 절정)" />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 효과 — 시너지의 종류입니다. 아래 '받지 못하는 효과'와 같은 값끼리 짝지어 판단하므로 종류를 정확히 골라야 합니다." />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 수치(%) — 퍼센트 숫자만 입력합니다. % 기호는 빼고 6, 10.5 처럼 적습니다. 값이 클수록 편성에서 우선합니다." />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 중첩 그룹 — 서로 겹쳐서 들어가지 않는 시너지에 같은 이름을 붙입니다. 같은 그룹이 한 파티에 여러 개 있으면 가장 높은 수치 하나만 계산합니다. 비워두면 항상 따로 더해집니다. (예: 공격력증가)" />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 조건부 / 조건 설명 — 특정 상황에서만 켜지는 시너지를 표시해 두는 메모입니다. 점수 계산에는 반영되지 않고 목록에만 보입니다." />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="입력 예시 — 제공 직업 '바드', 세팅 비움, 효과 '공격력 증가', 수치 6, 중첩 그룹 '공격력증가'" />
                            </StackPanel>
                        </Border>

                        <Border Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="제공 직업" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" Text="세팅(선택)" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" Text="효과" />
                                <TextBlock Grid.Column="3" Foreground="{StaticResource MutedTextBrush}" Text="수치(%)" />
                                <TextBlock Grid.Column="4" Foreground="{StaticResource MutedTextBrush}" Text="중첩 그룹" />
                                <TextBlock Grid.Column="5" Foreground="{StaticResource MutedTextBrush}" Text="조건부" />
                                <TextBlock Grid.Column="6" Foreground="{StaticResource MutedTextBrush}" Text="조건 설명" />
                                <TextBox Grid.Row="1" Margin="0,5,8,0" Text="{Binding NewSynergyClassName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,8,0" Text="{Binding NewSynergyBuildName, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,5,8,0"
                                          ItemsSource="{Binding SynergyKinds}"
                                          ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewSynergyKind}" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,5,8,0" Text="{Binding NewSynergyValue, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,5,8,0" Text="{Binding NewSynergyStackingGroup, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Row="1" Grid.Column="5" Margin="0,5,8,0" VerticalAlignment="Center" IsChecked="{Binding NewSynergyIsConditional}" Content="사용" />
                                <TextBox Grid.Row="1" Grid.Column="6" Margin="0,5,8,0" Text="{Binding NewSynergyConditionDescription, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="7" Margin="2,5,0,0" Command="{Binding AddSynergyCommand}" Content="규칙 추가" />
                            </Grid>
                        </Border>

                        <DataGrid Height="205" Margin="0,10,0,22" ItemsSource="{Binding Synergies}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="120" Header="직업" Binding="{Binding ClassName}" />
                                <DataGridTextColumn Width="130" Header="세팅" Binding="{Binding BuildName}" />
                                <DataGridTextColumn Width="180" Header="효과" Binding="{Binding KindName}" />
                                <DataGridTextColumn Width="90" Header="수치" Binding="{Binding ValueText}" />
                                <DataGridTextColumn Width="130" Header="중첩 그룹" Binding="{Binding StackingGroup}" />
                                <DataGridTextColumn Width="*" Header="적용 조건" Binding="{Binding ConditionText}" />
                                <DataGridTemplateColumn Width="80" Header="관리">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="10,5"
                                                    Background="#B74755"
                                                    Command="{Binding DataContext.RemoveSynergyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="삭제" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="시너지 적용 불가 규칙" />
                        <TextBlock Margin="0,6,0,10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="위와 반대로, 시너지를 '받는' 쪽 기준입니다. 파티에 그 시너지가 있어도 이 캐릭터에게는 점수로 쳐주지 않습니다." />

                        <Border Margin="0,0,0,12" Padding="14"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="입력 항목 설명" />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 수혜 직업 — 효과를 받지 못하는 쪽의 직업명입니다. (예: 블레이드)" />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 세팅(선택) — 특정 세팅만 해당할 때 입력합니다. 비워두면 그 직업 전체에 적용됩니다." />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 받지 못하는 효과 — 위 '제공 시너지'에서 고른 효과와 같은 종류를 선택해야 규칙이 맞물립니다." />
                                <TextBlock Margin="0,0,0,5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="· 사유 — 나중에 왜 넣었는지 알아보기 위한 메모입니다. 계산에는 쓰이지 않습니다." />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="입력 예시 — 이미 자체 버프로 치명타 적중률이 최대인 직업에 '치명타 적중률 증가'를 등록해 두면, 편성이 그 시너지를 다른 파티로 돌립니다." />
                            </StackPanel>
                        </Border>

                        <Border Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="수혜 직업" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" Text="세팅(선택)" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" Text="받지 못하는 효과" />
                                <TextBlock Grid.Column="3" Foreground="{StaticResource MutedTextBrush}" Text="사유" />
                                <TextBox Grid.Row="1" Margin="0,5,8,0" Text="{Binding NewExclusionClassName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,8,0" Text="{Binding NewExclusionBuildName, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,5,8,0"
                                          ItemsSource="{Binding SynergyKinds}"
                                          ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewExclusionKind}" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,5,8,0" Text="{Binding NewExclusionReason, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="4" Margin="2,5,0,0" Command="{Binding AddSynergyExclusionCommand}" Content="규칙 추가" />
                            </Grid>
                        </Border>

                        <DataGrid Height="190" Margin="0,10,0,0" ItemsSource="{Binding SynergyExclusions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="160" Header="수혜 직업" Binding="{Binding ReceiverClassName}" />
                                <DataGridTextColumn Width="160" Header="세팅" Binding="{Binding ReceiverBuildName}" />
                                <DataGridTextColumn Width="220" Header="받지 못하는 효과" Binding="{Binding KindName}" />
                                <DataGridTextColumn Width="*" Header="사유" Binding="{Binding Reason}" />
                                <DataGridTemplateColumn Width="80" Header="관리">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="10,5"
                                                    Background="#B74755"
                                                    Command="{Binding DataContext.RemoveSynergyExclusionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="삭제" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="주간 편성">
                <Grid Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="Bold" Text="캐릭터별 주간 레이드 선택" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="추천 3개 중 캐릭터가 갈 레이드만 1~3개 체크하고, 참여자 제목 줄에서 한 번에 확정합니다." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="참여자별 보기" />
                            <ComboBox Width="180" Margin="10,0,0,0"
                                      ItemsSource="{Binding CharacterOwnerFilters}"
                                      ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding CharacterOwnerFilterId}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding RefreshRecommendationsCommand}"
                                    Content="추천 다시 계산" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Margin="0,16,0,0"
                              IsReadOnly="False"
                              ItemsSource="{Binding RaidRecommendationsView}">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,6,0,2"
                                                Padding="8,5"
                                                Background="#2A2F45"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="10,0,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding ItemCount, StringFormat=캐릭터 {0}개}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Padding="12,5"
                                                        Command="{Binding DataContext.ConfirmOwnerRecommendationsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding Items[0]}"
                                                        Content="체크 항목 일괄 확정" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="150" Header="캐릭터" IsReadOnly="True" Binding="{Binding CharacterName}" />
                            <DataGridTextColumn Width="100" Header="레벨" IsReadOnly="True" Binding="{Binding ItemLevel, StringFormat=N2}" />
                            <DataGridTemplateColumn Width="*" Header="1순위">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding FirstRaid.DisplayName}"
                                                  IsChecked="{Binding FirstRaid.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding FirstRaid.IsAvailable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" Header="2순위">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding SecondRaid.DisplayName}"
                                                  IsChecked="{Binding SecondRaid.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding SecondRaid.IsAvailable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" Header="3순위">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding ThirdRaid.DisplayName}"
                                                  IsChecked="{Binding ThirdRaid.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding ThirdRaid.IsAvailable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,18,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="이번 주 확정 레이드" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding CurrentWeekLabel}" />
                    </Grid>

                    <Border Grid.Row="3" Margin="0,0,0,10" Padding="12,10"
                            Background="{StaticResource PanelBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="레이드 선택" />
                            <ComboBox Grid.Column="1" Margin="10,0,0,0"
                                      ItemsSource="{Binding RaidChoices}"
                                      ItemTemplate="{StaticResource DisplayNameComboItemTemplate}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding ReplacementRaidChoiceId}" />
                            <Button Grid.Column="2" Margin="10,0,0,0"
                                    Command="{Binding ApplyWeeklyRaidChangeCommand}"
                                    Content="변경 적용" />
                            <Button Grid.Column="3" Margin="8,0,0,0"
                                    Background="#2E8B68"
                                    Command="{Binding AddWeeklyRaidCommand}"
                                    Content="레이드 추가" />
                            <Button Grid.Column="4" Margin="8,0,0,0"
                                    Background="#566077"
                                    Command="{Binding CancelWeeklyRaidEditCommand}"
                                    Content="변경 취소" />
                            <TextBlock Grid.Column="5" Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding WeeklyRaidEditSummary}" />
                        </Grid>
                    </Border>

                    <!-- DataGrid의 열 재정렬·가로 오프셋 영향을 받지 않는 고정형 주간 레이드 표입니다. -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource PanelLightBrush}"
                                BorderBrush="#354057"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="캐릭터" />
                                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="레이드" />
                                <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="난이도" />
                                <TextBlock Grid.Column="3" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="관문" />
                                <TextBlock Grid.Column="4" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="상태" />
                                <TextBlock Grid.Column="5" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="관리" />
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Padding="0"
                                 Background="{StaticResource PanelBrush}"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 VirtualizingPanel.ScrollUnit="Item"
                                 ItemsSource="{Binding WeeklyRaidPlanView}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,6,0,2"
                                                    Padding="8,5"
                                                    Background="#2A2F45"
                                                    CornerRadius="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="10,0,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding ItemCount, StringFormat=확정 레이드 {0}개}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#30394B"
                                                        BorderThickness="0,0,0,1">
                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBorder" Property="Background" Value="#2B3345" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBorder" Property="Background" Value="#303852" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="320" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CharacterName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding RaidName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Text="{Binding Difficulty}" />
                                        <TextBlock Grid.Column="3" Margin="10,0" VerticalAlignment="Center" Text="{Binding ProgressText}" />
                                        <TextBlock Grid.Column="4" Margin="10,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
                                        <StackPanel Grid.Column="5" Margin="6,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Padding="10,5"
                                                    Command="{Binding DataContext.AdvanceRaidGateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Content="+1 관문" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="10,5"
                                                    Background="#566077"
                                                    Command="{Binding DataContext.ResetRaidProgressCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Content="초기화" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="10,5"
                                                    Command="{Binding DataContext.BeginEditWeeklyRaidCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding EditState}" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="10,5"
                                                    Background="#B74755"
                                                    Command="{Binding DataContext.RemoveWeeklyRaidCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Content="제외" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="5" Margin="0,16,0,0" Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding GeneratePartyCompositionCommand}" Content="자동 편성 실행" />
                            <TextBlock Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="결과는 '자동 편성 결과' 탭에서 확인할 수 있습니다." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="자동 편성 결과">
                <Grid Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="Bold" Text="공격대·파티 자동 편성" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="전투력 균형, 시너지, 캐릭터 재사용 점수를 함께 계산하며 확정 전에는 같은 역할끼리 파티를 교환할 수 있습니다." />
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding AutoPartySummary}" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <WrapPanel>
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="시너지 가중치" />
                            <TextBox Width="70" Text="{Binding SynergyWeight, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="18,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="전투력 균형" />
                            <TextBox Width="70" Text="{Binding CombatPowerBalanceWeight, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="18,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="가능 시간 가중치" />
                            <TextBox Width="70" Text="{Binding AvailabilityWeight, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="18,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="최소 공통 시간(분)" />
                            <TextBox Width="70" Text="{Binding MinimumCommonMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="18,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="캐릭터 교체 패널티" />
                            <TextBox Width="80" Text="{Binding CharacterSwitchPenalty, UpdateSourceTrigger=LostFocus}" />
                        </WrapPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,8" Orientation="Horizontal">
                        <Button Command="{Binding GeneratePartyCompositionCommand}" Content="자동 편성 초안 생성" />
                        <Button Margin="8,0,0,0" Background="#2E8B68" Command="{Binding ConfirmPartyCompositionCommand}" Content="전체 확정" />
                        <Button Margin="8,0,0,0" Background="#566077" Command="{Binding UnlockPartyCompositionCommand}" Content="확정 해제" />
                        <Button Margin="8,0,0,0" Background="#B74755" Command="{Binding ClearPartyCompositionCommand}" Content="초안 초기화" />
                        <Button Margin="20,0,0,0" Command="{Binding SwapSelectedPartyMembersCommand}" Content="선택한 2명 파티 교환" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="수동 조정 탭에서 같은 공격대·같은 역할 두 명을 선택하세요." />
                    </StackPanel>

                    <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
                        <TabItem Header="공격대 카드">
                            <ScrollViewer Margin="0,12,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AutoPartyTeamCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="400"
                                                    Margin="0,0,12,12"
                                                    Background="#151A24"
                                                    BorderBrush="#30394B"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <StackPanel>
                                                    <Border Padding="14,12"
                                                            Background="{Binding AccentColor}"
                                                            CornerRadius="11,11,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontSize="16"
                                                                           FontWeight="Bold"
                                                                           Text="{Binding RaidName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,5,0,0"
                                                                           Foreground="#E4E7F0">
                                                                    <TextBlock.Inlines>
                                                                        <Run Text="{Binding Difficulty}" />
                                                                        <Run Text=" · " />
                                                                        <Run Text="{Binding TeamName}" />
                                                                        <Run Text=" · " />
                                                                        <Run Text="{Binding FilledText}" />
                                                                    </TextBlock.Inlines>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    Padding="9,5"
                                                                    VerticalAlignment="Top"
                                                                    Background="#52000000"
                                                                    CornerRadius="12">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Margin="12">
                                                        <WrapPanel Margin="0,0,0,8">
                                                            <Border Margin="0,0,6,6" Padding="8,5" Background="#252B38" CornerRadius="10">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AverageCombatPower}" />
                                                            </Border>
                                                            <Border Margin="0,0,6,6" Padding="8,5" Background="#252B38" CornerRadius="10">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding SynergyScore}" />
                                                            </Border>
                                                            <Border Margin="0,0,6,6" Padding="8,5" Background="#252B38" CornerRadius="10">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PowerSpread}" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <ItemsControl ItemsSource="{Binding Parties}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,10"
                                                                            Padding="8"
                                                                            Background="#10141D"
                                                                            CornerRadius="8">
                                                                        <StackPanel>
                                                                            <Grid Margin="2,0,2,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock FontWeight="Bold" Text="{Binding PartyName}" />
                                                                                    <TextBlock Margin="8,0,0,0"
                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                               Text="{Binding MemberCountText}" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                                           Text="{Binding AverageCombatPower}" />
                                                                            </Grid>

                                                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <UniformGrid Columns="2" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border MinHeight="82"
                                                                                                Margin="3"
                                                                                                Padding="9,7"
                                                                                                BorderBrush="{Binding AccentColor}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="7">
                                                                                            <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Background" Value="#222733" />
                                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsVacancy}" Value="True">
                                                                                                            <Setter Property="Background" Value="#181D27" />
                                                                                                            <Setter Property="Opacity" Value="0.72" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Border.Style>
                                                                                            <Grid>
                                                                                                <Grid.RowDefinitions>
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                    <RowDefinition Height="Auto" />
                                                                                                </Grid.RowDefinitions>
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <TextBlock FontSize="10"
                                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                                               Text="{Binding OwnerName}"
                                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                                    <TextBlock Grid.Column="1"
                                                                                                               Margin="5,0,0,0"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{Binding AccentColor}"
                                                                                                               Text="{Binding RoleName}" />
                                                                                                </Grid>
                                                                                                <TextBlock Grid.Row="1"
                                                                                                           Margin="0,3,0,0"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Text="{Binding CharacterName}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <StackPanel Grid.Row="2" Margin="0,3,0,0" Orientation="Horizontal">
                                                                                                    <TextBlock FontSize="10"
                                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                                               Text="{Binding ClassName}" />
                                                                                                    <TextBlock Margin="6,0,0,0"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                                               Text="{Binding ItemLevel}" />
                                                                                                    <TextBlock Margin="6,0,0,0"
                                                                                                               FontSize="10"
                                                                                                               Foreground="{Binding AccentColor}"
                                                                                                               Text="{Binding CombatPower}" />
                                                                                                </StackPanel>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Border Padding="9,6" Background="#202632" CornerRadius="7">
                                                            <TextBlock HorizontalAlignment="Right"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding VacancyText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="교체 최소 순서">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,9" Background="{StaticResource PanelBrush}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="추천 진행 순서" />
                                        <TextBlock Margin="12,0,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AutoPartyRunOrderSummary}" />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              Margin="0,10,0,0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AutoPartyRunOrder}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Left" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="400"
                                                        Margin="0,0,12,12"
                                                        Background="#151A24"
                                                        BorderBrush="#30394B"
                                                        BorderThickness="1"
                                                        CornerRadius="11">
                                                    <StackPanel>
                                                        <Border Padding="12,10"
                                                                Background="{Binding Team.AccentColor}"
                                                                CornerRadius="10,10,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="34"
                                                                        Height="34"
                                                                        Background="#50000000"
                                                                        CornerRadius="17">
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="15"
                                                                               FontWeight="Bold"
                                                                               Text="{Binding Order}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0">
                                                                    <TextBlock FontWeight="Bold"
                                                                               Text="{Binding Team.RaidName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#E4E7F0">
                                                                        <Run Text="{Binding Team.Difficulty}" />
                                                                        <Run Text=" · " />
                                                                        <Run Text="{Binding Team.TeamName}" />
                                                                        <Run Text=" · " />
                                                                        <Run Text="{Binding Team.FilledText}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="2"
                                                                        Padding="8,4"
                                                                        VerticalAlignment="Center"
                                                                        Background="#50000000"
                                                                        CornerRadius="10">
                                                                    <TextBlock FontSize="11" Text="{Binding Team.StatusText}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Margin="11">
                                                            <Border Padding="9,7" Background="#252B38" CornerRadius="7">
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding TransitionSummary}" />
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="11"
                                                                               Foreground="#75C9B7"
                                                                               Text="{Binding AttendanceSummary}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,4,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               Text="{Binding ChangeDetails}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>

                                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Team.Parties}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,0,7"
                                                                                Padding="7"
                                                                                Background="#10141D"
                                                                                CornerRadius="7">
                                                                            <StackPanel>
                                                                                <StackPanel Margin="2,0,2,5" Orientation="Horizontal">
                                                                                    <TextBlock FontWeight="Bold" Text="{Binding PartyName}" />
                                                                                    <TextBlock Margin="7,0,0,0"
                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                               Text="{Binding MemberCountText}" />
                                                                                </StackPanel>
                                                                                <ItemsControl ItemsSource="{Binding Slots}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <UniformGrid Columns="2" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border MinHeight="48"
                                                                                                    Margin="2"
                                                                                                    Padding="7,5"
                                                                                                    Background="#222733"
                                                                                                    BorderBrush="{Binding AccentColor}"
                                                                                                    BorderThickness="1"
                                                                                                    CornerRadius="6">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <StackPanel>
                                                                                                        <TextBlock FontSize="9"
                                                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                                                   Text="{Binding OwnerName}"
                                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                                        <TextBlock Margin="0,2,0,0"
                                                                                                                   FontSize="11"
                                                                                                                   FontWeight="SemiBold"
                                                                                                                   Text="{Binding CharacterName}"
                                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                                    </StackPanel>
                                                                                                    <TextBlock Grid.Column="1"
                                                                                                               Margin="5,0,0,0"
                                                                                                               VerticalAlignment="Center"
                                                                                                               FontSize="9"
                                                                                                               Foreground="{Binding AccentColor}"
                                                                                                               Text="{Binding RoleName}" />
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem Header="수동 조정">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="190" />
                                </Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding AutoPartyMembers}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="125" Header="레이드" Binding="{Binding RaidName}" />
                                        <DataGridTextColumn Width="65" Header="공격대" Binding="{Binding TeamName}" />
                                        <DataGridTextColumn Width="60" Header="파티" Binding="{Binding PartyName}" />
                                        <DataGridTextColumn Width="95" Header="참여자" Binding="{Binding OwnerName}" />
                                        <DataGridTextColumn Width="*" Header="캐릭터" Binding="{Binding CharacterName}" />
                                        <DataGridTextColumn Width="70" Header="역할" Binding="{Binding RoleName}" />
                                        <DataGridTextColumn Width="90" Header="전투력" Binding="{Binding CombatPower}" />
                                        <DataGridTextColumn Width="65" Header="상태" Binding="{Binding ConfirmationState}" />
                                        <DataGridTemplateColumn Width="90" Header="파티 교환">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Padding="8,4"
                                                            Command="{Binding DataContext.ToggleSwapMemberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding SelectionState}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="105" Header="캐릭터 교체">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Padding="8,4"
                                                            Background="#566077"
                                                            Command="{Binding DataContext.SelectReplacementMemberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding ReplacementState}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="1" Margin="0,9,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="미편성 교체 후보" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Command="{Binding FillVacancyCommand}" Content="공석에 투입" />
                                        <Button Command="{Binding ReplacePartyMemberCommand}" Content="선택한 캐릭터 교체 실행" />
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="2" ItemsSource="{Binding UnassignedCharacters}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="150" Header="레이드" Binding="{Binding RaidName}" />
                                        <DataGridTextColumn Width="90" Header="난이도" Binding="{Binding Difficulty}" />
                                        <DataGridTextColumn Width="110" Header="참여자" Binding="{Binding OwnerName}" />
                                        <DataGridTextColumn Width="*" Header="캐릭터" Binding="{Binding CharacterName}" />
                                        <DataGridTextColumn Width="80" Header="역할" Binding="{Binding RoleName}" />
                                        <DataGridTextColumn Width="100" Header="전투력" Binding="{Binding CombatPower}" />
                                        <DataGridTextColumn Width="280" Header="미편성 사유" Binding="{Binding Reason}" />
                                        <DataGridTemplateColumn Width="110" Header="투입 선택">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Padding="8,4"
                                                            Command="{Binding DataContext.SelectUnassignedCharacterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding SelectionState}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="미편성">
                            <DataGrid Margin="0,12,0,0" ItemsSource="{Binding AutoPartyIssues}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="170" Header="레이드" Binding="{Binding RaidName}" />
                                    <DataGridTextColumn Width="100" Header="난이도" Binding="{Binding Difficulty}" />
                                    <DataGridTextColumn Width="*" Header="캐릭터" Binding="{Binding Characters}" />
                                    <DataGridTextColumn Width="420" Header="미편성 사유" Binding="{Binding Reason}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,18,0,0" Padding="12,8" Background="{StaticResource PanelBrush}" CornerRadius="8">
            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
